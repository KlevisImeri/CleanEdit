{
  "name": "cleanedit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch app.ts",
    "dev:frontend": "bun vite",
    "build:frontend": "bun vite build",
    "build:cli": "bun build ./app.ts --compile --minify --sourcemap --asset-naming=\"[name].[ext]\" --outfile cleanedit",
    "build": "bun run build:frontend && bun run build:cli",
    "test": "bun test tests/api.test.ts",
    "test:api": "bun test tests/api.test.ts",
    "test:frontend": "playwright test",
    "test:all": "bun test tests/api.test.ts && playwright test"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "@fortawesome/fontawesome-free": "^6.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rollup/rollup-linux-x64-gnu": "^4.57.1",
    "@rushstack/eslint-patch": "^1.15.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/bun": "latest",
    "@types/node": "^20.19.33",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^6.2.6",
    "postcss": "^8.5.6",
    "rollup": "^4.57.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.4.5",
    "vite": "^5.4.21",
    "vite-plugin-vue-devtools": "^7.7.9",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.2.12"
  }
}
